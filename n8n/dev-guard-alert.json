{
  "name": "dev-guard alert",
  "active": false,
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "dev-guard",
        "responseMode": "onReceived"
      }
    },
    {
      "name": "Filter New Highs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body;\nconst findings = body && Array.isArray(body.findings) ? body.findings : [];\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst fresh = [];\nfor (const f of findings) {\n  if (!f || f.severity !== 'high') continue;\n  const fp = [f.check_id, f.file, f.line, f.pattern].join('|');\n  if (store.seen[fp]) continue;\n  store.seen[fp] = true;\n  fresh.push(f.check_id + ' ' + f.file + ':' + f.line + ' ' + f.pattern);\n}\nreturn [{ json: { count: fresh.length, text: 'dev-guard: ' + fresh.length + ' new high finding(s)\\n' + fresh.join('\\n') } }];"
      }
    },
    {
      "name": "Any New?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "count-gt-0",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Filter New Highs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter New Highs": {
      "main": [
        [
          {
            "node": "Any New?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any New?": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {}
}
